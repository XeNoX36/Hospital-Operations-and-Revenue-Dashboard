      <column caption='Current Month Total Payment' datatype='real' name='[Calculation_0826030309740549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;SUM(IF MONTH([dimDateServicePK]) = MONTH({MAX([dimDateServicePK])})&#13;&#10;AND YEAR([dimDateServicePK]) = YEAR({MAX([dimDateServicePK])})&#13;&#10;THEN [Patient_Payment]+[Insurance_Payment] &#13;&#10;END)&#13;&#10;}' />
      </column>
      <column caption='Collected Amount' datatype='real' name='[Calculation_0870012787228673]' role='measure' type='quantitative'>
