  <worksheets>
    <worksheet name='AR by Payer'>
      <table>
        <view>
          <datasources>
            <datasource caption='FactTable+' name='federated.0z8uwsd0tka1uq18ebl20149izpv' />
          </datasources>
          <datasource-dependencies datasource='federated.0z8uwsd0tka1uq18ebl20149izpv'>
            <column datatype='real' name='[AR]' role='measure' type='quantitative' />
