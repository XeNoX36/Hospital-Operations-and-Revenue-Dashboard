      <column caption='Net Revenue' datatype='real' name='[Calculation_0346372984979461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Expenses]-[Adjustment])' />
      </column>
      <column caption='Adjustment Rate' datatype='real' default-format='p0.00%' name='[Calculation_0608331860324352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AR])/SUM([Gross Expenses])' />
      </column>
      <column caption='Collection Rate' datatype='real' default-format='p0.00%' name='[Calculation_0608331872194561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0870012787228673]/[Calculation_0346372984979461]' />
      </column>
      <column caption='Net Loss' datatype='real' name='[Calculation_0608331886551042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0346372984979461]-[Calculation_0870012787228673]' />
      </column>
      <column caption='Total Gross Expences' datatype='real' name='[Calculation_0639937941671936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Expenses])' />
      </column>
      <column caption='Total Insurance Payment' datatype='integer' name='[Calculation_0639937942523905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Insurance_Payment])' />
      </column>
      <column caption='Total Patient Payment' datatype='real' name='[Calculation_0639937943330818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Patient_Payment])' />
      </column>
      <column caption='Patient Count' datatype='integer' name='[Calculation_0639937944064003]' role='measure' type='quantitative'>
